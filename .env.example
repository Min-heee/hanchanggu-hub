# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다.
# Claude Console(platform.claude.com) > API Keys 에서 만든 키
ANTHROPIC_API_KEY=
# offline(기본, 무료 규칙 기반) · local(무료, 이 컴퓨터의 Ollama) · claude(유료 API, 직접 켤 때만)
INQUIRY_HUB_LLM=
# sqlite(기본) 또는 csv
CRM_ADAPTER=
# local 모드에서 쓸 Ollama 모델과 주소 (기본: qwen3:8b, http://127.0.0.1:11434)
OLLAMA_MODEL=
OLLAMA_URL=
# 네이버 톡톡 실제 연동 (README '네이버 톡톡 실제 연동' 참고). 토큰이 없으면 웹훅이 꺼져 있습니다.
NAVER_TALKTALK_WEBHOOK_TOKEN=
NAVER_TALKTALK_AUTH_KEY=
# 수신거부 웹훅 검증 값 (넣으면 헤더와 비교합니다)
NHN_WEBHOOK_SIGNATURE=
KAKAO_ADMIN_KEY=
